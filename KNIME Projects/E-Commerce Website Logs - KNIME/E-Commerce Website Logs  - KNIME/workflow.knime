    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;h1 style=&quot;text-align: center&quot;&gt;E-Commerce Website Logs&lt;/h1&gt;&lt;hr&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Retrieve data from MongoDB collection &amp;amp; convert it to table&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Transform data&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Remove $oid&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Create autogenerated incrementing column (id)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Clean up spelling&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Convert Age to integer values&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Convert AccessedDateTime to Date data type &amp;amp; Extract date &amp;amp; time parts&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;OneHotEncode (OHE) Discrete Features&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Handle AccessedDate &amp;amp; Extract date parts&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Send transformed data to MySQL table (that was just created)&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16777215"/>
            <entry key="x-coordinate" type="xint" value="-1045"/>
            <entry key="y-coordinate" type="xint" value="-750"/>
            <entry key="width" type="xint" value="455"/>
            <entry key="height" type="xint" value="290"/>
            <entry key="alignment" type="xstring" value="LEFT"/>
            <entry key="borderSize" type="xint" value="10"/>
            <entry key="borderColor" type="xint" value="12633286"/>
            <entry key="defFontSize" type="xint" value="-1"/>
            <entry key="annotation-version" type="xint" value="20230412"/>
            <config key="styles"/>
        </config>
    </config>
