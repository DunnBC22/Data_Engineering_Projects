    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;h1 style=&quot;text-align: center&quot;&gt;Comprehensive Supply Chain Analysis&lt;/h1&gt;&lt;hr&gt;&lt;p&gt;This pipeline:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Retrieve data from a MySQL table&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Transforms the data as follows:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Clean currency-related features and convert from String to integer&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Remove Single Value Feature(s)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Reformat dates &amp;amp; extract Date parts&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Rename Features&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sends transformed data to Postgres table&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16777215"/>
            <entry key="x-coordinate" type="xint" value="400"/>
            <entry key="y-coordinate" type="xint" value="-520"/>
            <entry key="width" type="xint" value="590"/>
