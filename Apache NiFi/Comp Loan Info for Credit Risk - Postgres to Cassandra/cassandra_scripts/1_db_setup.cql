CREATE KEYSPACE comp_loan_info_credit_risk_keyspace WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

CREATE TABLE comp_loan_info_credit_risk_keyspace.comp_loan_info_credit_risk_table_cassie (
    id INT,
	address_state VARCHAR,
	emp_length VARCHAR,
	emp_title VARCHAR,
	grade VARCHAR,
	home_ownership VARCHAR,
	issue_date VARCHAR,
	issue_date_day_of_month INT,
	issue_date_month_of_year INT,
	issue_date_quarter INT,
	issue_date_year INT,
	issue_date_day_of_week INT,
	issue_date_week_of_year INT,
	last_credit_pull_date VARCHAR,
	last_credit_pull_date_day_of_month INT,
	last_credit_pull_month_of_year INT,
	last_credit_pull_date_quarter INT,
	last_credit_pull_date_year INT,
	last_credit_pull_date_day_of_week INT,
	last_credit_pull_date_week_of_year INT,
	last_payment_date VARCHAR,
	last_payment_date_day_of_month INT,
	last_payment_date_month_of_year INT,
	last_payment_date_quarter INT,
	last_payment_date_year INT,
	last_payment_date_day_of_week INT,
	last_payment_date_week_of_year INT,
	loan_status VARCHAR,
	next_payment_date VARCHAR,
	next_payment_date_day_of_month INT,
	next_payment_date_month_of_year INT,
	next_payment_date_quarter INT,
	next_payment_date_year INT,
	next_payment_date_day_of_week INT,
	next_payment_date_week_of_year INT,
	member_id INT,
	purpose VARCHAR,
	sub_grade VARCHAR,
	term VARCHAR,
	verification_status VARCHAR,
	annual_income FLOAT,
	dti FLOAT,
	installment FLOAT,
	int_rate FLOAT,
	loan_amount INT,
	total_acc INT,
	total_payment FLOAT,
    PRIMARY KEY (id)
);