   EXTRACT(DAYOFWEEK FROM CAST(ship_date AS DATE)) AS ship_date_day_of_week,\n    EXTRACT(WEEK FROM CAST(ship_date AS DATE)) AS ship_date_week_of_year,\n    delivery_date,\n    EXTRACT(DAY FROM CAST(delivery_date AS DATE)) AS delivery_date_day_of_month,\n    EXTRACT(MONTH FROM CAST(delivery_date AS DATE)) AS delivery_date_month_of_year,\n    EXTRACT(QUARTER FROM CAST(delivery_date AS DATE)) AS delivery_date_quarter,\n    EXTRACT(YEAR FROM CAST(delivery_date AS DATE)) AS delivery_date_year,\n    EXTRACT(DAYOFWEEK FROM CAST(delivery_date AS DATE)) AS delivery_date_day_of_week,\n    EXTRACT(WEEK FROM CAST(delivery_date AS DATE)) AS delivery_date_week_of_year,\n    sales_team_id,\n    customer_id,\n    store_id,\n    product_id,\n    order_quantity,\n    discount_applied,\n\tunit_cost_in_usd,\n\tunit_price_in_usd,\n\tTIMESTAMPDIFF(DAY, \n        CAST(REPLACE(procured_date, 'T', ' ') AS TIMESTAMP), \n        CAST(REPLACE(delivery_date, 'T', ' ') AS TIMESTAMP)\n    ) AS procured_to_delivery_date,\n    TIMESTAMPDIFF(DAY, \n            CAST(REPLACE(order_date, 'T', ' ') AS TIMESTAMP), \n            CAST(REPLACE(delivery_date, 'T', ' ') AS TIMESTAMP)\n        ) AS order_to_delivery_date,\n    TIMESTAMPDIFF(DAY, \n            CAST(REPLACE(order_date, 'T', ' ') AS TIMESTAMP), \n            CAST(REPLACE(ship_date, 'T', ' ') AS TIMESTAMP)\n        ) AS order_to_ship_date\nFROM FLOWFILE","cache-schema":"true","dbf-default-precision":"10","record-writer":"99a939f2-cb4c-35e2-9bfe-5b7c043cde48","record-reader":"c447cea3-7e22-3c46-bb9d-271b2aa3d85a","include-zero-record-flowfiles":"true","dbf-default-scale":"0"},"propertyDescriptors":{"Transform Date Features":{"name":"Transform Date Features","displayName":"Transform Date Features","identifiesControllerService":false,"sensitive":false},"cache-schema":{"name":"cache-schema","displayName":"Cache Schema","identifiesControllerService":false,"sensitive":false},"dbf-default-precision":{"name":"dbf-default-precision","displayName":"Default