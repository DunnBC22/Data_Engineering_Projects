{"flowContents":{"identifier":"9c26bb72-b0f3-3f16-b49e-ebfe1801453c","instanceIdentifier":"4fd4e880-0195-1000-3c78-b1b67f1795c4","name":"NiFi Flow","comments":"","position":{"x":0.0,"y":0.0},"processGroups":[],"remoteProcessGroups":[],"processors":[{"identifier":"d26bf58e-bcb0-3e82-86b2-b77e8c1433ac","instanceIdentifier":"4ffb7c41-0195-1000-0000-00001adc3f95","name":"QueryRecord","comments":"","position":{"x":360.0,"y":296.0},"type":"org.apache.nifi.processors.standard.QueryRecord","bundle":{"group":"org.apache.nifi","artifact":"nifi-standard-nar","version":"1.27.0"},"properties":{"cache-schema":"true","dbf-default-precision":"10","record-writer":"908c089c-910f-3673-a9db-01a5c7325a9a","record-reader":"1e370c02-ece3-3ad1-9313-8f0a7afed949","include-zero-record-flowfiles":"true","dbf-default-scale":"0","column_updates":"SELECT\n\tROW_NUMBER() OVER () AS id,\n    CASE age\n        WHEN '16-20' THEN 0\n        WHEN '20-25' THEN 1\n        WHEN '25-30' THEN 2\n        WHEN '30-Above' THEN 3\n        ELSE -1\n    END AS age,\n    CASE sex\n        WHEN 'Male' THEN 0\n        WHEN 'Female' THEN 1\n        ELSE -1\n    END AS sex,\n    CASE occupation\n        WHEN 'Business' THEN 0\n        WHEN 'Corporate' THEN 1\n        WHEN 'Housewife' THEN 2\n        WHEN 'Others' THEN 3\n        WHEN 'Student' THEN 4\n        ELSE -1\n    END AS occupation,\n    CASE days_indoors\n        WHEN 'More than 2 months' THEN 0\n        WHEN '31-60 days' THEN 1\n        WHEN 'Go out Every day' THEN 2\n        WHEN '1-14 days' THEN 3\n        WHEN '15-30 days' THEN 4\n        ELSE -1\n    END AS days_indoors,\n    CASE growing_stress\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS growing_stress,\n    CASE quarantine_frustrations\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS quarantine_frustrations,\n    CASE changes_habits\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS changes_habits,\n    CASE mental_health_history\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS mental_health_history,\n    CASE weight_change\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS weight_change,\n    CASE mood_swings\n        WHEN 'Low' THEN 0\n        WHEN 'Medium' THEN 1\n        WHEN 'High' THEN 2\n        ELSE -1\n    END AS mood_swings,\n    CASE coping_struggles\n        WHEN 'No' THEN 0\n        WHEN 'Yes' THEN 1\n        ELSE -1\n    END AS coping_struggles,\n    CASE work_interest\n        WHEN 'No' THEN 0\n        WHEN 'Maybe' THEN 1\n        WHEN 'Yes' THEN 2\n        ELSE -1\n    END AS work_interest,\n    CASE social_weakness\n        WHEN 'No\\r' THEN 0\n        WHEN 'Maybe\\r' THEN 1\n        WHEN 'Yes\\r' THEN 2\n        ELSE -1\n    END AS social_weakness\nFROM FLOWFILE"},"propertyDescriptors":{"cache-schema":{"name":"cache-schema","displayName":"Cache Schema","identifiesControllerService":false,"sensitive":false},"dbf-default-precision":{"name":"dbf-default-precision","displayName":"Default Decimal Precision","identifiesControllerService":false,"sensitive":false},"record-writer":{"name":"record-writer","displayName":"Record Writer","identifiesControllerService":true,"sensitive":false},"record-reader":{"name":"record-reader","displayName":"Record Reader","identifiesControllerService":true,"sensitive":false},"include-zero-record-flowfiles":{"name":"include-zero-record-flowfiles","displayName":"Include Zero Record FlowFiles","identifiesControllerService":false,"sensitive":false},"dbf-default-scale":{"name":"dbf-default-scale","displayName":"Default Decimal Scale","identifiesControllerService":false,"sensitive":false},"column_updates":{"name":"column_updates","displayName":"column_updates","identifiesControllerService":false,"sensitive":false}},"styl