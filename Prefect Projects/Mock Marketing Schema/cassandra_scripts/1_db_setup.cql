CREATE KEYSPACE mock_marketing_schema_keyspace_cassie WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

CREATE TABLE mock_marketing_schema_keyspace_cassie.mock_marketing_schema_table_cassie (
    CustomerId text,
	AcquisitionCost double,
	InternetBankingIndicator boolean,
	DateFirstAccountOpened timestamp,
	DateLastAccountOpened timestamp,
	Pursuit text,
	PrimaryAdvisorOrgId int,
	PrimaryBranchProximity int,
	SatisfactionRatingFromSurvey text,
	SecondaryAdvisorId int,
	SecondaryAdvisorOrgId  int,
	SpecialTermsIndicator boolean,
	CustomerGender text,
	CustomerFirstName text,
	CustomerLastName text,
	CustomerEmail text,
	CustomerSocSecNumLastFour text,
	CustomerAgeRange text,
	CustomerAnnualIncome float,
	CustomerBirthYear int,
	CustomerCurrentEmploymentStartDate timestamp,
	CustomerBehavior text,
	CustomerEducationLevel text,
	CustomerEmploymentStatus text,
	CustomerMaritalStatus text,
	CustomerMonthlyNetIncome int,
	CustomerProfession text,
	CustomerStatus text,
	CustomerWalletSharePercentage int,
	MonthlyHousingCost int,
	ContactPreference text,
	CreditAuthorityLevel text,
	CreditScore int,
	CreditUtilization double,
	DebtServiceCoverageRatio int,
	HouseholdAddress text,
	HouseholdCity text,
	HouseholdCountry text,
	HouseholdState text,
	HouseholdZipCode text,
	HouseholdAddressLastChanged timestamp,
	HouseholdNumOfDependentChildren int,
	HouseholdFamilySize int,
	HouseholdHeadOfHouseholdIndicator boolean,
	HouseholdHomeOwnerIndicator boolean,
	UrbanCode text,
	PrimaryAdvisorId int,
	AdvertisingIndicator boolean,
	AttachmentAllowedIndicator boolean,
	PreferredCommunicationForm text,
	ImportanceLevelCode text,
	InfluenceScore int,
	MarketGroup text,
	LoyaltyRatingCode int,
	RecordedVoiceSampleId int,
	ReferralsValueCode text,
	RelationshipStartDate timestamp,
    PRIMARY KEY (CustomerId)
);